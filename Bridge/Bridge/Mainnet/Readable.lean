def get_attestation_participation_flag_indices (state : BeaconState) (data : AttestationData) (inclusion_delay : Uint64) (parent_slot : Slot) : SpecM (List Int) := do
  let mut payload_matches : Bool := default
  let c1 := ((uv ((data).target).epoch) == (uv (← get_current_epoch state)))
  if c1 then
    pure ()
  else
    pure ()
  let is_matching_source := ((data).source == (← (if c1 then (do pure (state).current_justified_checkpoint) else (do pure (state).previous_justified_checkpoint) : SpecM Checkpoint)))
  let target_root := (← get_block_root state ((data).target).epoch)
  let target_root_matches := ((bd ((data).target).root) == (bd target_root))
  let is_matching_target := (is_matching_source && target_root_matches)
  if (← is_attestation_same_slot state data) then
    assert ((uv (data).index) == (0 : Int))
    payload_matches := true
  else
    let slot_index := (← (uOp .mod (uv parent_slot) (uv SLOTS_PER_HISTORICAL_ROOT) : SpecM Slot))
    let payload_index := (← lget (state).execution_payload_availability (uv slot_index))
    payload_matches := ((uv (← uCast Uint64 (data).index)) == (uv (⟨if (payload_index).val then 1 else 0⟩ : Uint64)))
  let head_root := (← get_block_root_at_slot state (data).slot)
  let head_root_matches := ((bd (data).beacon_block_root) == (bd head_root))
  let is_matching_head := (is_matching_target && (head_root_matches && payload_matches))
  assert is_matching_source
  let mut participation_flag_indices := []
  if (← (if is_matching_source then (do pure (decide ((uv inclusion_delay) ≤ (uv (← integer_squareroot (⟨(SLOTS_PER_EPOCH).val⟩ : Uint64)))))) else pure false : SpecM Bool)) then
    participation_flag_indices := (← lappend participation_flag_indices TIMELY_SOURCE_FLAG_INDEX none)
  if is_matching_target then
    participation_flag_indices := (← lappend participation_flag_indices TIMELY_TARGET_FLAG_INDEX none)
  if (is_matching_head && ((uv inclusion_delay) == (uv MIN_ATTESTATION_INCLUSION_DELAY))) then
    participation_flag_indices := (← lappend participation_flag_indices TIMELY_HEAD_FLAG_INDEX none)
  return ((participation_flag_indices).map fun x => (uv x))


