    consolidation_balance_to_consume := per_epoch_consolidation_churn
  else
    consolidation_balance_to_consume := (state).consolidation_balance_to_consume
  if (decide ((uv consolidation_balance) > (uv consolidation_balance_to_consume))) then
    let balance_to_process := (← (uOp .sub (uv consolidation_balance) (uv consolidation_balance_to_consume) : SpecM Gwei))
