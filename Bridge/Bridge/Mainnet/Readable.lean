def process_slot (state : BeaconState) : SpecM BeaconState := do
  let mut state := state
  let slot_index := (← (uOp .mod (uv (state).slot) (uv SLOTS_PER_HISTORICAL_ROOT) : SpecM Slot))
  let previous_state_root := (← bytesOf Root (← htr enc_BeaconState state))
  let i1 := (uv slot_index)
  state := { state with state_roots := (← lset (state).state_roots i1 previous_state_root) }
  if ((bd ((state).latest_block_header).state_root) == (bd (⟨List.replicate 32 0⟩ : Bytes32))) then
    state := { state with latest_block_header := { (state).latest_block_header with state_root := previous_state_root } }
  let previous_block_root := (← bytesOf Root (← htr enc_BeaconBlockHeader (state).latest_block_header))
  let i2 := (uv slot_index)
  state := { state with block_roots := (← lset (state).block_roots i2 previous_block_root) }
  let next_slot_index := (← (uOp .mod (uv (← (uOp .add (uv (state).slot) (1 : Int) : SpecM Slot))) (uv SLOTS_PER_HISTORICAL_ROOT) : SpecM Slot))
  let i3 := (uv next_slot_index)
  state := { state with execution_payload_availability := (← lset (state).execution_payload_availability i3 (⟨false⟩ : Boolean)) }
  return state

