def state_transition (state : BeaconState) (signed_block : SignedBeaconBlock) (validate_result : Bool) : SpecM (BeaconState × SignedBeaconBlock) := do
  let mut state := state
  let mut signed_block := signed_block
  let r1 ← process_slots state ((signed_block).message).slot
  state := r1
  if validate_result then
    assert (← verify_block_signature state signed_block)
  let r2 ← process_block state (signed_block).message
  state := (r2).1
  signed_block := { signed_block with message := (r2).2 }
  if validate_result then
    assert ((bd ((signed_block).message).state_root) == (bd (← bytesOf Root (← htr enc_BeaconState state))))
  return (state, signed_block)


