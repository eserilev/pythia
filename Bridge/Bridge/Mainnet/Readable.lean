def slash_validator (state : BeaconState) (slashed_index : ValidatorIndex) (whistleblower_index : (Option ValidatorIndex)) : SpecM BeaconState := do
  let mut state := state
  let epoch := (← get_current_epoch state)
  let r1 ← initiate_validator_exit state slashed_index
  state := r1
  let i2 := (uv slashed_index)
  let _ := (← lget (state).validators i2)
  state := { state with validators := (← lset (state).validators i2 { (← lget (state).validators i2) with slashed := (⟨true⟩ : Boolean) }) }
  state := { state with validators := (← lset (state).validators i2 { (← lget (state).validators i2) with withdrawable_epoch := (← pyMax [((← lget (state).validators i2)).withdrawable_epoch, (← (uOp .add (uv epoch) (uv EPOCHS_PER_SLASHINGS_VECTOR) : SpecM Epoch))]) }) }
  let i3 := (uv (← (uOp .mod (uv epoch) (uv EPOCHS_PER_SLASHINGS_VECTOR) : SpecM Epoch)))
  state := { state with slashings := (← lset (state).slashings i3 (← (uOp .add (uv (← lget (state).slashings (uv (← (uOp .mod (uv epoch) (uv EPOCHS_PER_SLASHINGS_VECTOR) : SpecM Epoch))))) (uv ((← lget (state).validators i2)).effective_balance) : SpecM Gwei))) }
  let slashing_penalty := (← (uOp .floorDiv (uv ((← lget (state).validators i2)).effective_balance) (uv MIN_SLASHING_PENALTY_QUOTIENT_ELECTRA) : SpecM Gwei))
  let r4 ← decrease_balance state slashed_index slashing_penalty
  state := r4
  let proposer_index := (← get_beacon_proposer_index state)
  let whistleblower_index ← (match whistleblower_index with | some v => pure v | none => (do pure proposer_index) : SpecM ValidatorIndex)
  let whistleblower_reward := (← (uOp .floorDiv (uv ((← lget (state).validators i2)).effective_balance) (uv WHISTLEBLOWER_REWARD_QUOTIENT_ELECTRA) : SpecM Gwei))
  let proposer_reward := (← (uOp .floorDiv (uv (← (uOp .mul (uv whistleblower_reward) (uv PROPOSER_WEIGHT) : SpecM Gwei))) (uv WEIGHT_DENOMINATOR) : SpecM Gwei))
  let r5 ← increase_balance state proposer_index proposer_reward
  state := r5
  let r6 ← increase_balance state whistleblower_index (← (uOp .sub (uv whistleblower_reward) (uv proposer_reward) : SpecM Gwei))
  state := r6
  return state

def process_attester_slashing.loop1 (xs2 : (List ValidatorIndex)) (n1 : Nat) (i_ : Nat) (slashed_any_in : Bool) (state_in : BeaconState) : SpecM (Bool × BeaconState) :=
