def compute_exit_epoch_and_update_churn (state : BeaconState) (exit_balance : Gwei) : SpecM (Epoch × BeaconState) := do
  let mut state := state
  let mut exit_balance_to_consume : Gwei := default
  let mut earliest_exit_epoch := (← pyMax [(state).earliest_exit_epoch, (← compute_activation_exit_epoch (← get_current_epoch state))])
  let per_epoch_churn := (← get_exit_churn_limit state)
  if (decide ((uv (state).earliest_exit_epoch) < (uv earliest_exit_epoch))) then
    exit_balance_to_consume := per_epoch_churn
  else
    exit_balance_to_consume := (state).exit_balance_to_consume
  if (decide ((uv exit_balance) > (uv exit_balance_to_consume))) then
    let balance_to_process := (← (uOp .sub (uv exit_balance) (uv exit_balance_to_consume) : SpecM Gwei))
    let additional_epochs := (← (uOp .add (uv (← (uOp .floorDiv (uv (← (uOp .sub (uv balance_to_process) (1 : Int) : SpecM Gwei))) (uv per_epoch_churn) : SpecM Gwei))) (1 : Int) : SpecM Gwei))
    earliest_exit_epoch := (← (uOp .add (uv earliest_exit_epoch) (uv (← uCast Epoch additional_epochs)) : SpecM Epoch))
    exit_balance_to_consume := (← (uOp .add (uv exit_balance_to_consume) (uv (← (uOp .mul (uv additional_epochs) (uv per_epoch_churn) : SpecM Gwei))) : SpecM Gwei))
  state := { state with exit_balance_to_consume := (← (uOp .sub (uv exit_balance_to_consume) (uv exit_balance) : SpecM Gwei)) }
  state := { state with earliest_exit_epoch := earliest_exit_epoch }
  return ((state).earliest_exit_epoch, state)


