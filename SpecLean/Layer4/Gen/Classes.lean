  x.next_withdrawal_builder_index.val < 2 ^ 64 ∧
  (∀ y0 ∈ x.builder_pending_payments, ok_BuilderPendingPayment y0) ∧
  (∀ y0 ∈ x.builder_pending_withdrawals, ok_BuilderPendingWithdrawal y0) ∧
