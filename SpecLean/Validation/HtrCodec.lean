import SpecLean.Validation.HtrBridge
import SpecLean.DecodeLemmas

/-!
# Decoded values have the content of their encodings

`hash_tree_root` is an oracle that reads only the content of a value (`OracleHtr.ext`). To use it,
a proof needs `Bis`: a heap value has the content of the readable Lean's encoding of its decoded
value. This file proves that once per decoder shape. `Codecs.lean`, generated by
`tools/gen_codec.py`, applies it to every SSZ class.

An encoder runs in a heap that grows: it allocates each object after the objects it already made.
So an encoded value keeps its content while later encoders run (`good_ext`). `Ext h1 h2`: `h2`
keeps every object of `h1`. `Below h v`: every reference that `v` reaches is an object of `h`.
-/

namespace SpecLean.Validation.HtrBridge

open SpecLean SpecLean.Rd SpecLean.Rd.Gen

/-! ## Growing heaps -/

/-- `h2` keeps every object of `h1`. -/
def Ext (h1 h2 : Heap) : Prop := h1.next ≤ h2.next ∧ ∀ a, a < h1.next → h2.objs a = h1.objs a

theorem Ext.refl (h : Heap) : Ext h h := ⟨Nat.le_refl _, fun _ _ => rfl⟩

theorem Ext.trans {h1 h2 h3 : Heap} (a : Ext h1 h2) (b : Ext h2 h3) : Ext h1 h3 :=
  ⟨Nat.le_trans a.1 b.1, fun c hc => (b.2 c (Nat.lt_of_lt_of_le hc a.1)).trans (a.2 c hc)⟩

theorem ext_alloc (h : Heap) (o : HeapObj) : Ext h (h.alloc o).2 :=
  ⟨by rw [Where.alloc_next]; omega, fun _ hc => Where.objs_alloc_ne (by omega)⟩

/-- Every reference that `v` reaches is below `next`. -/
def Below (h : Heap) (v : Value) : Prop :=
  ∀ q c, Encode.follow h v q = some (.ref c) → c < h.next

theorem below_scalar (h : Heap) {v : Value} (hv : ∀ c, v ≠ .ref c) : Below h v := by
  intro q c e
  cases q with
  | nil => simp [Encode.follow] at e; exact (hv c e).elim
  | cons i p => cases v with
    | ref b => exact absurd rfl (hv b)
    | _ => simp [Encode.follow] at e

/-- An item of an object that a value reaches. -/
theorem below_item {h : Heap} {b : Nat} {o : HeapObj} {i : Nat} {x : Value}
    (hb : Below h (.ref b)) (ho : h.objs b = some o)
    (hx : (match o with
      | .container _ fs => fs[i]?
      | .list _ _ _ xs => xs[i]?
      | _ => none) = some x) : Below h x := by
  intro q c e
  refine hb (i :: q) c ?_
  cases o <;> simp_all [Encode.follow]

theorem follow_ext {h1 h2 : Heap} (he : Ext h1 h2) :
    ∀ (q : List Nat) (v : Value), Below h1 v → Encode.follow h2 v q = Encode.follow h1 v q
  | [], _, _ => rfl
  | i :: p, v, hb => by
    cases v with
    | ref b =>
      have hlt : b < h1.next := hb [] b rfl
      simp only [Encode.follow, he.2 b hlt]
      split
      · rename_i fs ho
        cases hx : fs[i]? with
        | none => rfl
        | some x =>
          simp only [Option.bind_some]
          exact follow_ext he p x (below_item hb ho (by simpa using hx))
      · rename_i k e l xs ho
        cases hx : xs[i]? with
        | none => rfl
        | some x =>
          simp only [Option.bind_some]
          exact follow_ext he p x (below_item hb ho (by simpa using hx))
      · rfl
    | _ => rfl

theorem below_ext {h1 h2 : Heap} (he : Ext h1 h2) {v : Value} (hb : Below h1 v) : Below h2 v :=
  fun q c e => Nat.lt_of_lt_of_le (hb q c (by rw [← follow_ext he q v hb]; exact e)) he.1

/-! ## Content in a growing heap -/

theorem bis_ext {h h2 : Heap} : ∀ d (w : Value) (h1 : Heap) (v : Value), Bis d h w h1 v →
    Below h1 v → Ext h1 h2 → Bis d h w h2 v := by
  intro d
  induction d with
  | zero =>
    intro w h1 v hb _ _
    by_cases hw : ∃ a, w = .ref a
    · obtain ⟨a, rfl⟩ := hw; obtain ⟨b, rfl⟩ := Bis_ref hb; simp [Bis]
    · rw [Bis_scalar (fun a e => hw ⟨a, e⟩) hb]; exact Bis_self_scalar 0 h h2 (fun a e => hw ⟨a, e⟩)
  | succ d ih =>
    intro w h1 v hb hbl he
    by_cases hw : ∃ a, w = .ref a
    · obtain ⟨a, rfl⟩ := hw
      obtain ⟨b, rfl⟩ := Bis_ref hb
      have hlt : b < h1.next := hbl [] b rfl
      simp only [Bis] at hb ⊢
      rw [he.2 b hlt]
      split at hb
      · rename_i ty fs ty' fs' ho ho'
        obtain ⟨rfl, hl, hi⟩ := hb
        exact ⟨rfl, hl, fun i x x' hx hx' =>
          ih x h1 x' (hi i x x' hx hx') (below_item hbl ho' (by simpa using hx')) he⟩
      · rename_i k e l xs k' e' l' xs' ho ho'
        obtain ⟨rfl, rfl, rfl, hl, hi⟩ := hb
        exact ⟨rfl, rfl, rfl, hl, fun i x x' hx hx' =>
          ih x h1 x' (hi i x x' hx hx') (below_item hbl ho' (by simpa using hx')) he⟩
      · exact hb.elim
    · rw [Bis_scalar (fun a e => hw ⟨a, e⟩) hb]
      exact Bis_self_scalar _ h h2 (fun a e => hw ⟨a, e⟩)

/-- `v` in `h1` has the content of `w` in `h` at every depth, and reaches only objects of `h1`. -/
def Good (h : Heap) (w : Value) (h1 : Heap) (v : Value) : Prop :=
  (∀ d, Bis d h w h1 v) ∧ Below h1 v

theorem good_ext {h h1 h2 : Heap} {w v : Value} (hg : Good h w h1 v) (he : Ext h1 h2) :
    Good h w h2 v :=
  ⟨fun d => bis_ext d w h1 v (hg.1 d) hg.2 he, below_ext he hg.2⟩

/-- Two lists of values related item by item by `Good`. -/
def GoodL (h : Heap) (ws : List Value) (h1 : Heap) (vs : List Value) : Prop :=
  ws.length = vs.length ∧ ∀ (i : Nat) w v, ws[i]? = some w → vs[i]? = some v → Good h w h1 v

theorem goodL_ext {h h1 h2 : Heap} {ws vs : List Value} (hg : GoodL h ws h1 vs) (he : Ext h1 h2) :
    GoodL h ws h2 vs :=
  ⟨hg.1, fun i w v hw hv => good_ext (hg.2 i w v hw hv) he⟩

theorem goodL_snoc {h h1 : Heap} {ws vs : List Value} {w v : Value} (hg : GoodL h ws h1 vs)
    (hn : Good h w h1 v) : GoodL h (ws ++ [w]) h1 (vs ++ [v]) := by
  refine ⟨by simp [hg.1], fun i x y hx hy => ?_⟩
  by_cases hi : i < ws.length
  · rw [List.getElem?_append_left hi] at hx
    rw [List.getElem?_append_left (hg.1 ▸ hi)] at hy
    exact hg.2 i x y hx hy
  · rw [List.getElem?_append_right (by omega)] at hx
    rw [List.getElem?_append_right (by rw [← hg.1]; omega)] at hy
    rw [hg.1] at hx
    by_cases he : i - vs.length = 0
    · rw [he] at hx hy; simp at hx hy; subst hx hy; exact hn
    · have : 0 < i - vs.length := Nat.pos_of_ne_zero he
      rw [List.getElem?_eq_none (by simp; omega)] at hx; cases hx

/-! ## The fold of the encoders -/

/-- The fold that `encList` and `encContainer` run: each encoder starts in the heap that the
previous one left. -/
theorem fold_ok {β : Type} (g : β → Heap → Value × Heap) :
    ∀ (xs : List β), (∀ x ∈ xs, ∀ h0, Ext h0 (g x h0).2 ∧ Below (g x h0).2 (g x h0).1) →
      ∀ (acc : List Value × Heap), (∀ v ∈ acc.1, Below acc.2 v) →
      let r := xs.foldl (fun (acc : List Value × Heap) x =>
        let (v, h1) := g x acc.2
        (acc.1 ++ [v], h1)) acc
      Ext acc.2 r.2 ∧ ∀ v ∈ r.1, Below r.2 v
  | [], _, acc, hb => ⟨Ext.refl _, hb⟩
  | x :: xs, hg, (vs, h1), hb => by
    simp only [List.foldl_cons]
    have ⟨he, hbx⟩ := hg x (List.mem_cons_self ..) h1
    have hb' : ∀ v ∈ vs ++ [(g x h1).1], Below (g x h1).2 v := by
      intro v hv
      rcases List.mem_append.1 hv with hv | hv
      · exact below_ext he (hb v hv)
      · simp at hv; subst hv; exact hbx
    have := fold_ok g xs (fun y hy => hg y (List.mem_cons_of_mem _ hy))
      (vs ++ [(g x h1).1], (g x h1).2) hb'
    exact ⟨he.trans this.1, this.2⟩

theorem fold_good {β : Type} {h : Heap} (g : β → Heap → Value × Heap) :
    ∀ (xs : List β), (∀ x ∈ xs, ∀ h0, Ext h0 (g x h0).2 ∧ Below (g x h0).2 (g x h0).1) →
      ∀ (ws : List Value) (acc : List Value × Heap) (wacc : List Value),
      ws.length = xs.length →
      (∀ (i : Nat) x w, xs[i]? = some x → ws[i]? = some w → ∀ h0, Good h w (g x h0).2 (g x h0).1) →
      GoodL h wacc acc.2 acc.1 →
      let r := xs.foldl (fun (acc : List Value × Heap) x =>
        let (v, h1) := g x acc.2
        (acc.1 ++ [v], h1)) acc
      GoodL h (wacc ++ ws) r.2 r.1
  | [], _, ws, acc, wacc, hl, _, hacc => by
    have : ws = [] := List.length_eq_zero_iff.mp hl
    subst this; simpa using hacc
  | x :: xs, hg, w :: ws, (vs, h1), wacc, hl, hall, hacc => by
    simp only [List.foldl_cons]
    have he := (hg x (List.mem_cons_self ..) h1).1
    have hnew := hall 0 x w rfl rfl h1
    have hacc' : GoodL h (wacc ++ [w]) (g x h1).2 (vs ++ [(g x h1).1]) :=
      goodL_snoc (goodL_ext hacc he) hnew
    have := fold_good g xs (fun y hy => hg y (List.mem_cons_of_mem _ hy)) ws
      (vs ++ [(g x h1).1], (g x h1).2) (wacc ++ [w])
      (by simpa using hl) (fun i y z hy hz h0 => hall (i + 1) y z hy hz h0) hacc'
    simpa using this
  | _ :: _, _, [], _, _, hl, _, _ => by simp at hl

/-! ## The new object -/

/-- An encoded object at `next`, whose items reach only older objects. -/
theorem alloc_ok {h0 hn : Heap} {o : HeapObj} {vs : List Value}
    (hitems : (∃ ty, o = .container ty vs) ∨ ∃ k e l, o = .list k e l vs)
    (he : Ext h0 hn) (hb : ∀ v ∈ vs, Below hn v) :
    Ext h0 (hn.alloc o).2 ∧ Below (hn.alloc o).2 (.ref hn.next) := by
  refine ⟨he.trans (ext_alloc hn o), fun q c e => ?_⟩
  rw [Where.alloc_next]
  have hitem : ∀ (i : Nat) x p, vs[i]? = some x →
      Encode.follow (hn.alloc o).2 x p = some (.ref c) → c < hn.next + 1 := by
    intro i x p hx e
    have hbx := hb x (List.mem_of_getElem? hx)
    rw [follow_ext (ext_alloc hn o) p x hbx] at e
    exact Nat.lt_succ_of_lt (hbx p c e)
  cases q with
  | nil => simp [Encode.follow] at e; omega
  | cons i p =>
    simp only [Encode.follow, Where.objs_alloc_self] at e
    rcases hitems with ⟨ty, rfl⟩ | ⟨k, e', l, rfl⟩
    · cases hx : vs[i]? with
      | none => simp [hx] at e
      | some x => simp [hx] at e; exact hitem i x p hx e
    · cases hx : vs[i]? with
      | none => simp [hx] at e
      | some x => simp [hx] at e; exact hitem i x p hx e

/-- A heap object and the new object of an encoder, with items related by `Good`. -/
theorem good_alloc {h hn : Heap} {a : Nat} {ws vs : List Value} {o o' : HeapObj}
    (ho : h.objs a = some o) (hsame : (∃ ty, o = .container ty ws ∧ o' = .container ty vs) ∨
      ∃ k e l, o = .list k e l ws ∧ o' = .list k e l vs)
    (hg : GoodL h ws hn vs) (hb : Below (hn.alloc o').2 (.ref hn.next)) :
    Good h (.ref a) (hn.alloc o').2 (.ref hn.next) := by
  refine ⟨fun d => ?_, hb⟩
  have hitem : ∀ (i : Nat) w v, ws[i]? = some w → vs[i]? = some v → ∀ d,
      Bis d h w (hn.alloc o').2 v := fun i w v hw hv d =>
    bis_ext d w hn v ((hg.2 i w v hw hv).1 d) (hg.2 i w v hw hv).2 (ext_alloc hn o')
  cases d with
  | zero => simp [Bis]
  | succ d =>
    simp only [Bis, ho, Where.objs_alloc_self]
    rcases hsame with ⟨ty, rfl, rfl⟩ | ⟨k, e, l, rfl, rfl⟩
    · exact ⟨rfl, hg.1, fun i w v hw hv => hitem i w v hw hv d⟩
    · exact ⟨rfl, rfl, rfl, hg.1, fun i w v hw hv => hitem i w v hw hv d⟩

/-! ## Codecs -/

/-- A decoder and its encoder: the encoder grows the heap, and a decoded heap value has the
content of the encoding of its value. -/
structure Codec {α : Type} (dec : Dec α) (enc : Enc α) : Prop where
  ok : ∀ x h0, Ext h0 (enc x h0).2 ∧ Below (enc x h0).2 (enc x h0).1
  good : ∀ h v x, dec h v = some x → Shaped h v → ∀ h0, Good h v (enc x h0).2 (enc x h0).1

theorem codec_uint {α : Type} [UintC α] (t : UintTy) : Codec (decUintT (α := α) t) (encUint t) where
  ok _ h0 := ⟨Ext.refl h0, below_scalar h0 (fun _ e => by cases e)⟩
  good h v x hd _ h0 := by
    cases v with
    | lib l =>
      cases l with
      | uint t' n =>
        simp only [decUintT] at hd
        split at hd
        · rename_i hc
          obtain ⟨rfl, -⟩ := hc
          cases hd
          simp only [encUint, UintC.val_ofNat]
          exact ⟨fun d => Bis_self_scalar d h h0 (fun _ e => by cases e),
            below_scalar h0 (fun _ e => by cases e)⟩
        · cases hd
      | boolean _ => simp [decUintT] at hd
    | _ => simp [decUintT] at hd

theorem codec_bytes {α : Type} [BytesC α] (c : Name) : Codec (decBytesT (α := α) c) (encBytesN c) where
  ok _ h0 := ⟨Ext.refl h0, below_scalar h0 (fun _ e => by cases e)⟩
  good h v x hd _ h0 := by
    rw [decBytesT_some hd]
    exact ⟨fun d => Bis_self_scalar d h h0 (fun _ e => by cases e),
      below_scalar h0 (fun _ e => by cases e)⟩

theorem codec_boolean : Codec decBooleanV encBoolean where
  ok _ h0 := ⟨Ext.refl h0, below_scalar h0 (fun _ e => by cases e)⟩
  good h v x hd _ h0 := by
    cases v with
    | lib l =>
      cases l with
      | boolean b =>
        simp only [decBooleanV] at hd; cases hd
        exact ⟨fun d => Bis_self_scalar d h h0 (fun _ e => by cases e),
          below_scalar h0 (fun _ e => by cases e)⟩
      | uint _ _ => simp [decBooleanV] at hd
    | _ => simp [decBooleanV] at hd

/-- An item of an object that a shaped value reaches is shaped. -/
theorem shaped_item {h : Heap} {a : Nat} {o : HeapObj} {i : Nat} {x : Value}
    (hs : Shaped h (.ref a)) (ho : h.objs a = some o)
    (hx : (match o with
      | .container _ fs => fs[i]?
      | .list _ _ _ xs => xs[i]?
      | _ => none) = some x) : Shaped h x := by
  intro q c ty fs tys e
  refine hs (i :: q) c ty fs tys ?_
  cases o <;> simp_all [Encode.follow]

theorem codec_list {α : Type} {D : Dec α} {E : Enc α} (k : ListKind) (e : SszTy)
    (l : Option Nat) (hc : Codec D E) : Codec (decListT k e l D) (encList k e l E) where
  ok xs h0 := by
    have ⟨he, hb⟩ := fold_ok (fun x h => E x h) xs (fun x _ h => hc.ok x h) ([], h0) (by simp)
    exact alloc_ok (.inr ⟨k, e, l, rfl⟩) he hb
  good h v ys hd hs h0 := by
    obtain ⟨a, ws, rfl, ho, hm⟩ := decListT_some hd
    obtain ⟨hlen, hel⟩ := (Encode.mapM_some_iff _ _).mp hm
    have hg := fold_good (h := h) (fun x h => E x h) ys (fun x _ h => hc.ok x h) ws ([], h0) []
      hlen.symm (fun i y w hy hw h0' => by
        have hd' := hel i w hw
        rw [hy] at hd'
        exact hc.good h w y hd' (shaped_item hs ho (by simpa using hw)) h0') ⟨rfl, by simp⟩
    have ⟨he, hb⟩ := fold_ok (fun x h => E x h) ys (fun x _ h => hc.ok x h) ([], h0) (by simp)
    have hbn := (alloc_ok (o := .list k e l _) (.inr ⟨k, e, l, rfl⟩) he hb).2
    exact good_alloc ho (.inr ⟨k, e, l, rfl, rfl⟩) (by simpa using hg) hbn

/-! ## Containers -/

theorem cont_ok (ty : Name) (Fs : List (Heap → Value × Heap))
    (hok : ∀ F ∈ Fs, ∀ h0, Ext h0 (F h0).2 ∧ Below (F h0).2 (F h0).1) (h0 : Heap) :
    Ext h0 (encContainer ty Fs h0).2 ∧ Below (encContainer ty Fs h0).2 (encContainer ty Fs h0).1 := by
  have ⟨he, hb⟩ := fold_ok (fun F h => F h) Fs hok ([], h0) (by simp)
  exact alloc_ok (.inl ⟨ty, rfl⟩) he hb

/-- A container decoded from `ws` against the container that `encContainer` makes from `Fs`:
`Good` when the lengths agree and each field is `Good`. -/
theorem cont_good {h : Heap} {a : Nat} {ty : Name} {ws : List Value}
    (ho : h.objs a = some (.container ty ws)) (Fs : List (Heap → Value × Heap))
    (hok : ∀ F ∈ Fs, ∀ h0, Ext h0 (F h0).2 ∧ Below (F h0).2 (F h0).1)
    (hl : ws.length = Fs.length)
    (hfield : ∀ (i : Nat) w F, ws[i]? = some w → Fs[i]? = some F → ∀ h0, Good h w (F h0).2 (F h0).1)
    (h0 : Heap) :
    Good h (.ref a) (encContainer ty Fs h0).2 (encContainer ty Fs h0).1 := by
  have hgood := fold_good (h := h) (fun F h => F h) Fs hok ws ([], h0) [] hl
    (fun i F w hF hw h0' => hfield i w F hw hF h0') ⟨rfl, by simp⟩
  have ⟨he, hb⟩ := fold_ok (fun F h => F h) Fs hok ([], h0) (by simp)
  have hbn := (alloc_ok (o := .container ty _) (.inl ⟨ty, rfl⟩) he hb).2
  exact good_alloc ho (.inl ⟨ty, rfl, rfl⟩) (by simpa using hgood) hbn

/-! ## Containers with many fields

The same two lemmas with the field conditions as nested conjunctions, so a generated proof
gives them as one term, with no search over the fields. -/

/-- Each encoder of the list grows the heap. -/
def AllOk : List (Heap → Value × Heap) → Prop
  | [] => True
  | F :: Fs => (∀ h0, Ext h0 (F h0).2 ∧ Below (F h0).2 (F h0).1) ∧ AllOk Fs

/-- Each field value against its encoder. -/
def AllGood (h : Heap) : List Value → List (Heap → Value × Heap) → Prop
  | [], [] => True
  | w :: ws, F :: Fs => (∀ h0, Good h w (F h0).2 (F h0).1) ∧ AllGood h ws Fs
  | _, _ => False

theorem allOk_mem : ∀ {Fs : List (Heap → Value × Heap)}, AllOk Fs →
    ∀ F ∈ Fs, ∀ h0, Ext h0 (F h0).2 ∧ Below (F h0).2 (F h0).1
  | [], _, F, hF => by simp at hF
  | G :: Gs, ⟨hG, hGs⟩, F, hF => by
    rcases List.mem_cons.1 hF with rfl | hF
    · exact hG
    · exact allOk_mem hGs F hF

theorem allGood_get {h : Heap} : ∀ {ws : List Value} {Fs : List (Heap → Value × Heap)},
    AllGood h ws Fs → ws.length = Fs.length ∧
      ∀ (i : Nat) w F, ws[i]? = some w → Fs[i]? = some F → ∀ h0, Good h w (F h0).2 (F h0).1
  | [], [], _ => ⟨rfl, fun i w F hw _ => by simp at hw⟩
  | w :: ws, F :: Fs, ⟨hw, hrest⟩ => by
    obtain ⟨hl, hi⟩ := allGood_get hrest
    refine ⟨by simp [hl], fun i x G hx hG => ?_⟩
    cases i with
    | zero => simp at hx hG; subst hx hG; exact hw
    | succ i => exact hi i x G (by simpa using hx) (by simpa using hG)
  | [], _ :: _, h => h.elim
  | _ :: _, [], h => h.elim

theorem cont_ok' (ty : Name) (Fs : List (Heap → Value × Heap)) (hok : AllOk Fs) (h0 : Heap) :
    Ext h0 (encContainer ty Fs h0).2 ∧ Below (encContainer ty Fs h0).2 (encContainer ty Fs h0).1 :=
  cont_ok ty Fs (allOk_mem hok) h0

theorem cont_good' {h : Heap} {a : Nat} {ty : Name} {ws : List Value}
    (ho : h.objs a = some (.container ty ws)) (Fs : List (Heap → Value × Heap)) (hok : AllOk Fs)
    (hg : AllGood h ws Fs) (h0 : Heap) :
    Good h (.ref a) (encContainer ty Fs h0).2 (encContainer ty Fs h0).1 :=
  cont_good ho Fs (allOk_mem hok) (allGood_get hg).1 (allGood_get hg).2 h0

/-- One step of a decoder: an `Option` bind that succeeds. -/
theorem obind_some {α β : Type} {o : Option α} {f : α → Option β} {b : β}
    (h : (o >>= f) = some b) : ∃ a, o = some a ∧ f a = some b := by
  cases o with
  | none => cases h
  | some a => exact ⟨a, rfl, h⟩

/-- The bridge for any class with a codec: the oracle on a decoded value gives the readable
`htr`. -/
theorem htr_codec [Spec] {α : Type} {dec : Dec α} {enc : Enc α} {sha : Oracle}
    (ho : OracleHtr sha) (hc : Codec dec enc) {h : Heap} {v : Value} {x : α}
    (hd : dec h v = some x) (hs : Shaped h v) :
    erase (sha.hashTreeRoot h v) = htr enc x :=
  htr_bridge ho enc ((hc.good h v x hd hs Heap.empty).1 64)

end SpecLean.Validation.HtrBridge
