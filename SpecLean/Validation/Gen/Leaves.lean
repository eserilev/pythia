  simp only [dec_Validator, dec_BLSPubkey, dec_Bytes32, dec_Gwei, dec_Epoch, Option.bind_eq_bind, Option.bind_eq_some_iff, rd_simp, Option.pure_def, Option.some.injEq, Value.ref.injEq, exists_eq_left', exists_eq_right] at hy0
  rd_split_hyps
  refine ⟨64, fun fuel hf => ?_⟩
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hf
  clear hf
  simp [rd_simp, lookup_lit, unfold_known, fieldIndex_lit, Scope.fn_is_slashable_validator, is_slashable_validator, Scope.env, Scope.knownNames, *]
  repeat' (rd_split <;> (try rd_step))
  all_goals rd_finish

set_option maxHeartbeats 4000000 in
theorem saturating_sub_valid (h : Heap) (x0 : Nat) (x1 : Int) :
    ∃ N, ∀ fuel ≥ N,
      ResultMatches [] h [(.uint (.width 64) x0), (.int x1)] (fun (r : Uint64) h' v => (v, h') = enc_Uint64 r h)
        (interp (Scope.env sha) fuel Scope.Id.«saturating_sub» [(.uint (.width 64) x0), (.int x1)] h)
        (saturating_sub (⟨x0⟩ : Uint64) x1) := by
  refine ⟨64, fun fuel hf => ?_⟩
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hf
  clear hf
  simp [rd_simp, lookup_lit, unfold_known, fieldIndex_lit, Scope.fn_saturating_sub, saturating_sub, Scope.env, Scope.knownNames, enc_Uint64, encUint, encBytesN]
  repeat' (rd_split <;> (try rd_step))
  all_goals rd_finish

